# ─────────────────────────────────────────────────────────────────────────────
# CiviLedger production env — lives ONLY on the droplet at deploy/.env.production
# (git-ignored). Copy this file there and fill it in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public hostname for HTTPS ────────────────────────────────────────────────
# An sslip.io name that resolves to this droplet's IP, so Caddy can get a
# Let's Encrypt cert without you owning a domain. Format: dashes for dots.
#   droplet IP 203.0.113.10  ->  203-0-113-10.sslip.io
PUBLIC_HOSTNAME=YOUR-DROPLET-IP-WITH-DASHES.sslip.io
ACME_EMAIL=you@example.com

# ── Frontend ────────────────────────────────────────────────────────────────
# The Cloudflare Pages URL. Drives CORS and the share/QR links the API builds.
FRONTEND_URL=https://civiledger.pages.dev

# ── App secrets ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=civiledger
DB_USER=civiledger
# Generate: openssl rand -hex 24
DB_PASSWORD=

# ── Behaviour ───────────────────────────────────────────────────────────────
# Seed demo orgs/accounts on first boot (idempotent afterwards).
SEED_ON_START=true
# Bind the raw backend port to localhost (Caddy fronts it). Set 0.0.0.0 only if
# you deliberately want http://<IP>:4000 reachable from the internet.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=4000

# ── Blockchain ──────────────────────────────────────────────────────────────
# Default: the bundled local Hardhat chain. Keys auto-derive; leave the block below empty.
DERIVE_LOCAL_KEYS=true

# To use Polygon Amoy instead (durable anchors, public explorer):
#   1. comment out the `chain` and `contracts-deploy` services in docker-compose.prod.yml
#   2. deploy the contracts once from a machine with a funded key:
#        cd contracts && npx hardhat run scripts/deploy.js --network amoy
#      then copy contracts/deployments/amoy.json + backend/src/contracts-abi/*.json onto
#      the droplet at a path both are set to below (or bake them into the backend image)
#   3. set the values below
# BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# BLOCKCHAIN_NETWORK=amoy
# DEPLOYMENTS_FILE=/chain/deployments/amoy.json
# CONTRACTS_ABI_DIR=/chain/abi
# DERIVE_LOCAL_KEYS=false
# ADMIN_PRIVATE_KEY=
# IDENTITY_AUTHORITY_PRIVATE_KEY=
# EDUCATION_AUTHORITY_PRIVATE_KEY=
# TRANSPORT_AUTHORITY_PRIVATE_KEY=
