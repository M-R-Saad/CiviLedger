# Cloudflare Pages build environment.
# Set these in the Pages project: Settings -> Environment variables -> Production.
# This file is documentation only; Pages does not read it.

# Backend API base URL. Must be HTTPS: a plain http:// value is BLOCKED by the
# browser as mixed content because Pages serves this app over HTTPS.
# The host must match deploy/.env.production PUBLIC_HOSTNAME *exactly* (that is the
# only name Caddy holds a TLS cert for). sslip.io accepts dots or dashes, e.g.
# https://152.42.205.205.sslip.io  or  https://152-42-205-205.sslip.io
# Changing this in the Pages dashboard only takes effect on the next build.
VITE_API_BASE_URL=https://YOUR-DROPLET-IP.sslip.io

# Optional: block explorer for on-chain evidence links. Empty for the local chain;
# https://amoy.polygonscan.com when running on Polygon Amoy.
VITE_EXPLORER_BASE_URL=
