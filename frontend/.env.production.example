# Cloudflare Pages build environment.
# Set these in the Pages project: Settings -> Environment variables -> Production.
# This file is documentation only; Pages does not read it.

# Backend API base URL. Use the droplet's HTTPS endpoint (Caddy + sslip.io).
# A plain http://<IP>:4000 value will be BLOCKED by the browser as mixed content
# because Pages serves this app over HTTPS. See docs/06_DEPLOYMENT.md.
VITE_API_BASE_URL=https://YOUR-DROPLET-IP-WITH-DASHES.sslip.io

# Optional: block explorer for on-chain evidence links. Empty for the local chain;
# https://amoy.polygonscan.com when running on Polygon Amoy.
VITE_EXPLORER_BASE_URL=

