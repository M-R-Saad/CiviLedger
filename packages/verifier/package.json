{
  "name": "@civiledger/verifier",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "The public CiviLedger verification library. MIT-licensed so anyone can verify a credential without touching our servers.",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@civiledger/credential": "workspace:*",
    "@civiledger/status-list": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
