{
  "name": "@civiledger/anchor-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drains the ledger outbox; anchors nightly audit roots and the weekly public checkpoint.",
  "scripts": {
    "build": "pnpm --filter @civiledger/api build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @civiledger/api build && tsx watch src/worker.ts",
    "start": "node dist/worker.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@civiledger/api": "workspace:*",
    "@civiledger/chain": "workspace:*",
    "@prisma/client": "^6.1.0",
    "pino": "^9.5.0",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
