# ─────────────────────────────────────────────────────────────────────────────
# Local development defaults. For production on the droplet, values come from
# deploy/.env.production (see docs/06_DEPLOYMENT.md) — do not copy this file there.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Frontend origin. In production set this to the Cloudflare Pages URL.
# Used for CORS and for the share/QR links the backend generates (APP_BASE_URL).
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Set when the API runs behind Caddy / a reverse proxy (production). 1 = trust one hop.
TRUST_PROXY=

# Database (Sequelize/Postgres). In Docker, DB_HOST is the compose service name "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civiledger
DB_USER=postgres
DB_PASSWORD=postgres
# To use SQLite instead for zero-setup local dev, set DB_DIALECT=sqlite and DB_STORAGE=./dev.sqlite
DB_DIALECT=postgres
DB_STORAGE=

# Container entrypoint behaviour (ignored outside Docker).
AUTO_MIGRATE=true
SEED_ON_START=false

# Blockchain connection — must match contracts/deployments/<network>.json
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK=localhost
# Absolute in Docker (shared volume the deploy step writes), relative in local dev.
DEPLOYMENTS_FILE=../contracts/deployments/localhost.json
CONTRACTS_ABI_DIR=

# Private keys for the backend to sign transactions on behalf of the demo issuer orgs.
# For a local / containerised Hardhat chain these are the standard PUBLIC Hardhat test
# keys (accounts 0-3). NEVER reuse them on a public testnet or mainnet.
ADMIN_PRIVATE_KEY=
IDENTITY_AUTHORITY_PRIVATE_KEY=
EDUCATION_AUTHORITY_PRIVATE_KEY=
TRANSPORT_AUTHORITY_PRIVATE_KEY=
