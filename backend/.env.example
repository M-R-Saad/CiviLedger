PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Database (Sequelize/Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civiledger
DB_USER=postgres
DB_PASSWORD=postgres
# To use SQLite instead for zero-setup local dev, set DB_DIALECT=sqlite and DB_STORAGE=./dev.sqlite
DB_DIALECT=postgres
DB_STORAGE=

# Blockchain connection — must match contracts/deployments/<network>.json
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK=localhost
DEPLOYMENTS_FILE=../contracts/deployments/localhost.json

# Private keys for the backend to sign transactions on behalf of the demo issuer orgs.
# In the prototype the backend co-signs so citizens/issuers don't need to run their own node.
# Copy these from `npx hardhat node` output or from seed-demo-data.js console output.
ADMIN_PRIVATE_KEY=
IDENTITY_AUTHORITY_PRIVATE_KEY=
EDUCATION_AUTHORITY_PRIVATE_KEY=
TRANSPORT_AUTHORITY_PRIVATE_KEY=
