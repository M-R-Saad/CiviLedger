# Devnet configuration. Copy to .env and keep it out of git.
#
# The chain keys below are Anvil test accounts, published in Foundry docs and
# worthless. The encryption keys are generated fresh here: a repository is not
# a key store, and a shared DATA_ENCRYPTION_KEY would make every developer able
# to read every other deployment.

POSTGRES_PASSWORD=civiledger

# Generated per environment. Rotate by prepending a new id: 2:<new>,1:<old>
DATA_ENCRYPTION_KEYS=1:z5bv10DWzxcpShpClReLgFiUoQ/rxD1IEWHmv680ecU=
BLIND_INDEX_KEY=5jY1ke8MGKYSlOMbaeUjmLJbRIWMb5Sn44/xYylmjAI=
SESSION_SECRET=SIIFqT4hEZETQCxFmdq9BTVA4JR1Y7SkM3+93Q4Qm/k=

# Registry writes only. Never an issuer signing key (invariant 25).
ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# keccak256("civiledger.org.civiledger")
ADMIN_ORG_ID=0x01ff3b1f3874ed2a0df6d27ea39592959f8238d44e6cdbe5629896c988e18690

PUBLIC_BASE_URL=http://localhost:4000
CONSOLE_ORIGIN=http://localhost:5173
VERIFY_ORIGIN=http://localhost:5174
WALLET_ORIGIN=http://localhost:5175
