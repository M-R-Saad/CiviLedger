# Build a workspace service into a slim runtime image.
#
#   docker build -f infra/Dockerfile.node --build-arg SERVICE=api .
#
# Multi-stage so the runtime image carries no toolchain: a container that can
# compile TypeScript is a container that can run whatever an attacker writes.

FROM node:22-bookworm-slim AS build
WORKDIR /repo

RUN corepack enable

# Copy only the manifests first, so a source change does not re-resolve the
# whole dependency graph.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/credential/package.json  packages/credential/
COPY packages/status-list/package.json packages/status-list/
COPY packages/verifier/package.json    packages/verifier/
COPY packages/chain/package.json       packages/chain/
COPY packages/ui/package.json          packages/ui/
COPY services/api/package.json         services/api/
COPY services/anchor-worker/package.json services/anchor-worker/
COPY infra/package.json                infra/

RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY services ./services
COPY contracts/out ./contracts/out

RUN pnpm --filter "./packages/**" build \
 && pnpm --filter @civiledger/api exec prisma generate \
 && pnpm --filter @civiledger/api build \
 && pnpm --filter @civiledger/anchor-worker exec tsc -p tsconfig.json

# Drop dev dependencies from the tree that ships.
RUN pnpm prune --prod

FROM node:22-bookworm-slim AS runtime
WORKDIR /repo
ARG SERVICE
ENV NODE_ENV=production
ENV SERVICE=${SERVICE}

# openssl is required by Prisma's query engine.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl wget \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/services ./services
COPY --from=build /repo/package.json ./package.json

USER node

# `node` rather than a shell wrapper, so SIGTERM reaches the process directly
# and the graceful shutdown in server.ts actually runs.
CMD ["sh", "-c", "node services/${SERVICE}/dist/$([ \"$SERVICE\" = api ] && echo server.js || echo worker.js)"]
